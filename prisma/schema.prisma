generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Drop {
  id                     String    @id @default(uuid())
  name                   String
  slug                   String    @unique
  price                  Int       // cents, 1 pouch
  price3                 Int?      // cents, 3 pouches
  price5                 Int?      // cents, 5 pouches
  images                 String[]  // URLs
  vibeLine               String?   // 6-10 word vibe line
  effectType             String?   // Calming / Energizing / Balancing / Neutral
  caffeine               String?   // Yes / No / MayContain / Unknown
  tastingNotes           String?
  ingredientMayInclude   String?   // comma-separated families
  steepGuide             String?   // e.g. "200°F / 3-5 min"
  allergenNote           String?
  dropNotes              String?   // batch date / vibe
  batchQuantityTotal     Int
  batchQuantityRemaining Int
  dropStartDate          DateTime?
  recipe                 Json?     // admin only: [{ ingredientId, name, parts }]
  mood                   String?
  flavorDirection        String?
  bestTime               String?
  description            String?
  packGrams              Int       @default(28)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  orders                 Order[]
}

model Order {
  id              String   @id @default(uuid())
  dropId          String?
  drop            Drop?    @relation(fields: [dropId], references: [id])
  mixItems        String?  // custom mix: tea names, comma-separated
  recipe          Json?    // snapshot at checkout: { packGrams, lines: [{ inventoryNo, name, brand, parts, grams }] }
  quantity        Int      @default(1)
  email           String?
  stripeSessionId String   @unique
  stripePaymentId String?
  status          String   @default("pending") // pending, paid, failed, review, refunded
  totalAmount     Int      // cents
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([dropId])
}

model InventoryIngredient {
  id                String   @id @default(uuid())
  inventoryNo       Int?     @unique
  name              String
  brand             String?
  teaNumber         String?
  category          String?  // type column: herbal, black tea, green tea, etc.
  ingredientsKey    String?  // known ingredients or VERIFY_ON_PACK / UNKNOWN
  flavorNotes       String?
  wellnessFunction  String?
  caffeineLevel     String?  // None, Low, Medium, High, Decaf, VERIFY_ON_PACK
  culturalRoots     String?
  format            String?  // packaging format
  verificationLevel String?  // THREAD_LOG, ASSUMED_PARTIAL
  notes             String?
  inStock           Boolean  @default(true)
  mixFamily         String?  // override for the mix builder family; "none" hides it from mixing
  gramsOnHand       Int?     // loose grams left; under 30 g counts as low stock
  rare              Boolean  @default(false) // marked rare by hand; low stock teas are rare too
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Pairing rules for the public "make your own mix" builder.
// A rule blocks familyA from being mixed with familyB. familyB "*" means familyA is never mixed.
model MixRule {
  id        String   @id @default(uuid())
  familyA   String
  familyB   String
  reason    String?
  createdAt DateTime @default(now())
}

model MixSetting {
  id        String   @id @default("default")
  minTeas   Int      @default(2)
  maxTeas   Int      @default(3)
  price     Int      @default(1600) // cents, 1 pouch
  price3    Int?     // cents, 3 pouches
  price5    Int?     // cents, 5 pouches
  packGrams Int      @default(28)
  isEnabled Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt
}
