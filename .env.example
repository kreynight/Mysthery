# Database — Supabase Postgres (pooler for serverless / Vercel)
# Get from: Supabase Dashboard > Settings > Database > Connection string > Transaction mode
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (for migrations only — not through pooler)
# Get from: Supabase Dashboard > Settings > Database > Connection string > Direct
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Stripe — get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Your site URL (used for Stripe redirect URLs)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Admin password — used to log in at /admin
ADMIN_PASSWORD="change-me-to-something-secure"

# Optional: Instagram link shown in footer
NEXT_PUBLIC_INSTAGRAM_URL=""
